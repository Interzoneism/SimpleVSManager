{
  "rules": {
    ".read": false,
    ".write": false,

    "owners": {
      "$playerUid": {
        ".read": "auth != null && data.val() == auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.exists() && data.val() == auth.uid && (!newData.exists() || newData.val() == auth.uid)))",
        ".validate": "$playerUid.length <= 128 && newData.isString()"
      }
    },

    "users": {
      "$playerUid": {
        ".read": "auth != null && root.child('owners').child($playerUid).val() == auth.uid",
        "$slot": {
          ".write": "auth != null && ($slot == 'slot1' || $slot == 'slot2' || $slot == 'slot3' || $slot == 'slot4' || $slot == 'slot5') && root.child('owners').child($playerUid).val() == auth.uid",
          ".validate": "newData.hasChildren(['content']) && newData.child('content').hasChildren()"
        }
      }
    },

    "registry": {
      ".read": true,
      "$entryId": {
        ".write": "auth != null && ((newData.exists() && newData.parent().parent().child('registryOwners').child($entryId).val() == auth.uid) || (!newData.exists() && root.child('registryOwners').child($entryId).val() == auth.uid))",
        ".validate": "$entryId.length <= 64 && newData.hasChildren(['content']) && newData.child('content').child('uploaderId').isString() && newData.parent().parent().child('owners').child(newData.child('content').child('uploaderId').val()).val() == auth.uid",
        "owner": { ".validate": false },
        "content": {
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "uploader": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "uploaderName": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "uploaderId": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "gameVersion": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "vsVersion": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "icon": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "iconColor": { ".validate": "newData.isString() && newData.val().length <= 64" }
        }
      }
    },

    "registrySummaries": {
      ".read": true,
      "$entryId": {
        ".write": "auth != null && ((newData.exists() && newData.parent().parent().child('registryOwners').child($entryId).val() == auth.uid) || (!newData.exists() && root.child('registryOwners').child($entryId).val() == auth.uid))",
        ".validate": "$entryId.length <= 64 && newData.hasChildren(['content', 'dateAdded']) && newData.child('dateAdded').isString()",
        "dateAdded": { ".validate": "newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "revision": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "content": {
          ".validate": "newData.hasChildren()",
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "version": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "uploader": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "uploaderName": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "gameVersion": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "vsVersion": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "icon": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "iconColor": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "mods": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,4}$/) && newData.child('modId').isString()",
              "modId": { ".validate": "newData.val().length <= 100" },
              "version": { ".validate": "newData.isString() && newData.val().length <= 50" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "registryOwners": {
      "$entryId": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.exists() && data.val() == auth.uid && (!newData.exists() || newData.val() == auth.uid)))",
        ".validate": "$entryId.length <= 64 && newData.isString()"
      }
    },

    "modlistSubscriptions": {
      ".read": true,
      "$entryId": {
        ".write": "auth != null && !newData.exists() && root.child('registryOwners').child($entryId).val() == auth.uid",
        "$subscriberId": {
          ".write": "auth != null && (($subscriberId == auth.uid && root.child('registry').child($entryId).exists() && root.child('registryOwners').child($entryId).val() != auth.uid) || (root.child('registryOwners').child($entryId).val() == auth.uid && !newData.exists()))",
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
        }
      }
    },

    "modlistSubscriptionNotices": {
      "$entryId": {
        ".read": "auth != null && root.child('registryOwners').child($entryId).val() == auth.uid",
        ".write": "auth != null && !newData.exists() && root.child('registryOwners').child($entryId).val() == auth.uid",
        "$subscriberId": {
          ".write": "auth != null && (($subscriberId == auth.uid && !data.exists() && newData.exists() && root.child('registry').child($entryId).exists() && root.child('registryOwners').child($entryId).val() != auth.uid) || (root.child('registryOwners').child($entryId).val() == auth.uid && !newData.exists()))",
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
        }
      }
    },

    "compatVotes": {
      ".read": true,
      "$modKey": {
        ".validate": "$modKey.length <= 200",
        "$versionKey": {
          ".validate": "$versionKey.length <= 100",
          "users": {
            ".read": true,
            "$userId": {
              ".write": "auth != null && auth.uid == $userId",
              ".validate": "newData.hasChildren(['option','vintageStoryVersion','updatedUtc']) && newData.child('option').isString() && (newData.child('option').val() == 'fullyFunctional' || newData.child('option').val() == 'noIssuesSoFar' || newData.child('option').val() == 'someIssuesButWorks' || newData.child('option').val() == 'notFunctional' || newData.child('option').val() == 'crashesOrFreezesGame' || newData.child('option').val() == 'workingPerfectly' || newData.child('option').val() == 'notWorking') && newData.child('vintageStoryVersion').isString() && newData.child('vintageStoryVersion').val().length <= 32 && newData.child('updatedUtc').isString() && newData.child('updatedUtc').val().length <= 40 && (!newData.child('comment').exists() || (newData.child('comment').isString() && newData.child('comment').val().length <= 1000)) && (!((newData.child('option').val() == 'notFunctional') || (newData.child('option').val() == 'notWorking') || (newData.child('option').val() == 'crashesOrFreezesGame')) || (newData.child('comment').isString() && newData.child('comment').val().matches(/[^ ]/)))",
              "option": { ".validate": true },
              "vintageStoryVersion": { ".validate": true },
              "updatedUtc": { ".validate": true },
              "comment": { ".validate": true },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
