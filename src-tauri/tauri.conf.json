{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple VS Manager",
  "mainBinaryName": "Simple VS Manager",
  "identifier": "com.interzone.simplevsmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple VS Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: svsm: http://svsm.localhost https://moddbcdn.vintagestory.at; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Vintage Story mod manager",
    "longDescription": "Portable, user-friendly Vintage Story mod manager for Windows, macOS and Linux.",
    "copyright": "Interzone",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
